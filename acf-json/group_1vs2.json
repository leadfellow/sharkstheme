            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_1vs2_title",
            "label": "Title",
            "name": "title",
            "type": "text",
            "instructions": "Main title (e.g., \"Koduleht vs E-pood\")",
            "required": 1,
            "default_value": "Koduleht vs E-pood",
            "placeholder": "Koduleht vs E-pood",
            "maxlength": 100
        },
        {
            "key": "field_1vs2_title_highlight",
            "label": "Title Highlight Word",
            "name": "title_highlight",
            "type": "text",
