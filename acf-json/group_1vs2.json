                    "required": 1,
                    "placeholder": "<svg viewBox=\"0 0 42 42\" fill=\"none\">...</svg>",
                    "rows": 4
                },
                {
                    "key": "field_1vs2_card_label",
                    "label": "Label",
                    "name": "label",
                    "type": "text",
                    "instructions": "Card label (small text)",
                    "required": 1,
                    "placeholder": "koduleht",
                    "maxlength": 50
