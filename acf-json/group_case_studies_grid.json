{
    "key": "group_case_studies_grid",
    "title": "Case Studies Grid Block",
    "fields": [
        {
            "key": "field_case_studies_grid_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"portfolio\", \"tood\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #portfolio",
            "required": 0,
            "placeholder": "nt. portfolio, tood",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_csg_title",
            "label": "Section Title",
            "name": "section_title",
            "type": "text",
            "instructions": "",
            "required": 0,
            "default_value": "Our Work",
            "placeholder": "Our Work"
        },
        {
            "key": "field_csg_subtitle",
            "label": "Section Subtitle",
            "name": "section_subtitle",
            "type": "textarea",
            "instructions": "",
            "required": 0,
            "rows": 2,
            "default_value": "Explore our latest projects and success stories",
            "placeholder": ""
        },
        {
            "key": "field_csg_count",
            "label": "Number of Case Studies to Show",
            "name": "posts_to_show",
            "type": "number",
            "instructions": "Leave empty to show all",
            "required": 0,
            "default_value": 6,
            "min": 1,
            "max": 100
        },
        {
            "key": "field_csg_category",
            "label": "Filter by Category",
            "name": "filter_category",
            "type": "taxonomy",
            "instructions": "Leave empty to show all categories",
            "required": 0,
            "taxonomy": "case_study_category",
            "field_type": "select",
            "allow_null": 1,
            "add_term": 0,
            "save_terms": 0,
            "load_terms": 0,
            "return_format": "id",
            "multiple": 0
        },
        {
            "key": "field_csg_layout",
            "label": "Grid Layout",
            "name": "grid_layout",
            "type": "select",
            "instructions": "",
            "required": 0,
            "choices": {
                "2-col": "2 Columns",
                "3-col": "3 Columns",
                "4-col": "4 Columns"
            },
            "default_value": "3-col",
            "allow_null": 0,
            "multiple": 0,
            "ui": 0,
            "return_format": "value"
        },
        {
            "key": "field_csg_show_excerpt",
            "label": "Show Excerpt",
            "name": "show_excerpt",
            "type": "true_false",
            "instructions": "",
            "required": 0,
            "default_value": 1,
            "ui": 1
        },
        {
            "key": "field_csg_show_cta",
            "label": "Show View All Button",
            "name": "show_cta",
            "type": "true_false",
            "instructions": "",
            "required": 0,
            "default_value": 1,
            "ui": 1
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/case-studies-grid"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

