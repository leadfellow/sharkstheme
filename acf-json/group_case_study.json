{
    "key": "group_case_study",
    "title": "Case Study Details",
    "fields": [
        {
            "key": "field_cs_client",
            "label": "Client Name",
            "name": "client_name",
            "type": "text",
            "instructions": "Name of the client or company",
            "required": 0,
            "default_value": "",
            "placeholder": "Acme Corporation"
        },
        {
            "key": "field_cs_timeline",
            "label": "Project Timeline",
            "name": "project_timeline",
            "type": "text",
            "instructions": "Duration of the project",
            "required": 0,
            "default_value": "",
            "placeholder": "3 months"
        },
        {
            "key": "field_cs_year",
            "label": "Project Year",
            "name": "project_year",
            "type": "number",
            "instructions": "Year the project was completed",
            "required": 0,
            "default_value": "",
            "placeholder": "2024"
        },
        {
            "key": "field_cs_hero_image",
            "label": "Hero Image",
            "name": "hero_image",
            "type": "image",
            "instructions": "Large hero image for the case study",
            "required": 0,
            "return_format": "array",
            "preview_size": "large",
            "library": "all"
        },
        {
            "key": "field_cs_challenge",
            "label": "The Challenge",
            "name": "challenge",
            "type": "textarea",
            "instructions": "Describe the problem or challenge",
            "required": 0,
            "rows": 4
        },
        {
            "key": "field_cs_solution",
            "label": "The Solution",
            "name": "solution",
            "type": "textarea",
            "instructions": "Describe how you solved it",
            "required": 0,
            "rows": 4
        },
        {
            "key": "field_cs_results",
            "label": "The Results",
            "name": "results",
            "type": "textarea",
            "instructions": "Describe the outcomes and impact",
            "required": 0,
            "rows": 4
        },
        {
            "key": "field_cs_key_features",
            "label": "Key Features",
            "name": "key_features",
            "type": "repeater",
            "instructions": "List key features or highlights",
            "required": 0,
            "layout": "table",
            "button_label": "Add Feature",
            "sub_fields": [
                {
                    "key": "field_cs_feature_text",
                    "label": "Feature",
                    "name": "feature_text",
                    "type": "text",
                    "required": 0
                }
            ]
        },
        {
            "key": "field_cs_technologies",
            "label": "Technologies Used",
            "name": "technologies",
            "type": "repeater",
            "instructions": "List technologies, tools, or platforms used",
            "required": 0,
            "layout": "table",
            "button_label": "Add Technology",
            "sub_fields": [
                {
                    "key": "field_cs_tech_name",
                    "label": "Technology",
                    "name": "tech_name",
                    "type": "text",
                    "required": 0
                }
            ]
        },
        {
            "key": "field_cs_metrics",
            "label": "Project Metrics",
            "name": "metrics",
            "type": "repeater",
            "instructions": "Key metrics and statistics",
            "required": 0,
            "layout": "table",
            "button_label": "Add Metric",
            "sub_fields": [
                {
                    "key": "field_cs_metric_value",
                    "label": "Value",
                    "name": "metric_value",
                    "type": "text",
                    "required": 0,
                    "placeholder": "150%"
                },
                {
                    "key": "field_cs_metric_label",
                    "label": "Label",
                    "name": "metric_label",
                    "type": "text",
                    "required": 0,
                    "placeholder": "Increase in conversions"
                }
            ]
        },
        {
            "key": "field_cs_testimonial",
            "label": "Client Testimonial",
            "name": "testimonial",
            "type": "group",
            "instructions": "",
            "required": 0,
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_cs_testimonial_text",
                    "label": "Testimonial Text",
                    "name": "text",
                    "type": "textarea",
                    "required": 0,
                    "rows": 3
                },
                {
                    "key": "field_cs_testimonial_author",
                    "label": "Author Name",
                    "name": "author",
                    "type": "text",
                    "required": 0,
                    "placeholder": "John Smith"
                },
                {
                    "key": "field_cs_testimonial_position",
                    "label": "Author Position",
                    "name": "position",
                    "type": "text",
                    "required": 0,
                    "placeholder": "CEO, Company Name"
                }
            ]
        },
        {
            "key": "field_cs_gallery",
            "label": "Project Gallery",
            "name": "gallery",
            "type": "gallery",
            "instructions": "Additional images showcasing the project",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_cs_website_url",
            "label": "Project Website URL",
            "name": "website_url",
            "type": "url",
            "instructions": "Link to the live project",
            "required": 0,
            "placeholder": "https://example.com"
        }
    ],
    "location": [
        [
            {
                "param": "post_type",
                "operator": "==",
                "value": "case_study"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

