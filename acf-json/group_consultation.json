{
    "key": "group_consultation_block",
    "title": "Consultation Block",
    "fields": [
        {
            "key": "field_consultation_heading",
            "label": "Heading",
            "name": "heading",
            "type": "text",
            "instructions": "Main heading text",
            "required": 1,
            "default_value": "Soovid nõu digiturunduses?",
            "placeholder": "Soovid nõu digiturunduses?"
        },
        {
            "key": "field_consultation_description",
            "label": "Description",
            "name": "description",
            "type": "textarea",
            "instructions": "Description text below heading",
            "required": 0,
            "rows": 3,
            "default_value": "Oleme avatud ka tasuta 30-minutiliseks konsultatsiooniks – broneeri aeg endale sobival hetkel.",
            "placeholder": "Enter description..."
        },
        {
            "key": "field_consultation_button_text",
            "label": "Button Text",
            "name": "button_text",
            "type": "text",
            "instructions": "Text on the button",
            "required": 1,
            "default_value": "Broneeri konsultatsioon",
            "placeholder": "Broneeri konsultatsioon"
        },
        {
            "key": "field_consultation_button_url",
            "label": "Button URL",
            "name": "button_url",
            "type": "url",
            "instructions": "Where the button should link to",
            "required": 0,
            "default_value": "#",
            "placeholder": "https://"
        },
        {
            "key": "field_consultation_ticker_enabled",
            "label": "Show Ticker Banner",
            "name": "ticker_enabled",
            "type": "true_false",
            "instructions": "Enable pink ticker banner below",
            "default_value": 1
        },
        {
            "key": "field_consultation_ticker_text",
            "label": "Ticker Text",
            "name": "ticker_text",
            "type": "text",
            "instructions": "Text that scrolls in the ticker banner",
            "conditional_logic": [
                [
                    {
                        "field": "field_consultation_ticker_enabled",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ],
            "default_value": "Astu turundusteadlik samm ja tule konsultatsioonile",
            "placeholder": "Astu turundusteadlik samm ja tule konsultatsioonile"
        },
        {
            "key": "field_consultation_ticker_bg_color",
            "label": "Ticker Background Color",
            "name": "ticker_bg_color",
            "type": "color_picker",
            "instructions": "Background color for ticker banner",
            "conditional_logic": [
                [
                    {
                        "field": "field_consultation_ticker_enabled",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ],
            "default_value": "#f237a6"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/consultation"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
