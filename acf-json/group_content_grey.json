{
    "key": "group_content_grey_block",
    "title": "Content Grey Block",
    "fields": [
        {
            "key": "field_content_grey_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"content\", \"sisu\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #content",
            "required": 0,
            "placeholder": "nt. content, sisu",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_content_grey_background_color",
            "label": "Background Color",
            "name": "background_color",
            "type": "color_picker",
            "instructions": "Choose background color for the entire section",
            "required": 0,
            "default_value": "#f5f5f5"
        },
        {
            "key": "field_content_grey_heading_parts",
            "label": "Heading Parts",
            "name": "heading_parts",
            "type": "repeater",
            "instructions": "Add heading parts with different colors, icons, and line breaks",
            "required": 0,
            "min": 1,
            "max": 0,
            "layout": "block",
            "button_label": "Add Part",
            "sub_fields": [
                {
                    "key": "field_content_grey_part_type",
                    "label": "Part Type",
                    "name": "part_type",
                    "type": "select",
                    "instructions": "Choose text, icon, or line break",
                    "required": 1,
                    "choices": {
                        "text": "Text",
                        "icon": "Icon",
                        "line_break": "Line Break"
                    },
                    "default_value": "text",
                    "allow_null": 0
                },
                {
                    "key": "field_content_grey_part_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Text content",
                    "required": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_content_grey_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ],
                    "placeholder": "Enter text..."
                },
                {
                    "key": "field_content_grey_part_color",
                    "label": "Text Color",
                    "name": "color",
                    "type": "select",
                    "instructions": "Choose text color",
                    "required": 0,
                    "choices": {
                        "black": "Black",
                        "gray": "Gray"
                    },
                    "default_value": "black",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_content_grey_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_content_grey_part_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "instructions": "Choose an icon",
                    "required": 0,
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "x",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_content_grey_part_type",
                                "operator": "==",
                                "value": "icon"
                            }
                        ]
                    ]
                }
            ]
        },
        {
            "key": "field_content_grey_subtitle",
            "label": "Subtitle (Under Heading)",
            "name": "subtitle",
            "type": "textarea",
            "instructions": "Subtitle text shown under heading (supports line breaks)",
            "required": 0,
            "rows": 4,
            "placeholder": "Kui veebileht aitab olla pildil, siis SEO aitab olla päriselt nähtav..."
        },
        {
            "key": "field_content_grey_content_text",
            "label": "Content Text (Right Column)",
            "name": "content_text",
            "type": "textarea",
            "instructions": "Main content text on the right (supports line breaks and paragraphs)",
            "required": 0,
            "rows": 8,
            "placeholder": "Enter content text..."
        },
        {
            "key": "field_content_grey_read_more_text",
            "label": "Read More Link Text",
            "name": "read_more_text",
            "type": "text",
            "instructions": "Optional 'Read more' link text",
            "required": 0,
            "placeholder": "Loe edasi"
        },
        {
            "key": "field_content_grey_read_more_url",
            "label": "Read More Link URL",
            "name": "read_more_url",
            "type": "url",
            "instructions": "URL for the read more link",
            "required": 0,
            "placeholder": "#"
        },
        {
            "key": "field_content_grey_show_cta",
            "label": "Show CTA Button",
            "name": "show_cta",
            "type": "true_false",
            "instructions": "Show CTA button at the bottom",
            "required": 0,
            "default_value": 0
        },
        {
            "key": "field_content_grey_cta_text",
            "label": "CTA Button Text",
            "name": "cta_text",
            "type": "text",
            "instructions": "CTA button text",
            "required": 0,
            "default_value": "küsi pakkumist",
            "placeholder": "küsi pakkumist",
            "conditional_logic": [
                [
                    {
                        "field": "field_content_grey_show_cta",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_content_grey_cta_url",
            "label": "CTA Button URL",
            "name": "cta_url",
            "type": "url",
            "instructions": "CTA button URL",
            "required": 0,
            "default_value": "#contact",
            "placeholder": "#contact",
            "conditional_logic": [
                [
                    {
                        "field": "field_content_grey_show_cta",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_content_grey_show_image",
            "label": "Show Image",
            "name": "show_image",
            "type": "true_false",
            "instructions": "Show image at the bottom (can be combined with CTA)",
            "required": 0,
            "default_value": 0
        },
        {
            "key": "field_content_grey_image",
            "label": "Image",
            "name": "image",
            "type": "image",
            "instructions": "Image to display at the bottom",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all",
            "conditional_logic": [
                [
                    {
                        "field": "field_content_grey_show_image",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/content-grey"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

