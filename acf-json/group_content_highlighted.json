{
    "key": "group_content_highlighted_block",
    "title": "Content with Highlighted Block",
    "fields": [
        {
            "key": "field_content_highlighted_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"content\", \"sisu\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #content",
            "required": 0,
            "placeholder": "nt. content, sisu",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_content_highlighted_show_icon",
            "label": "Show Icon",
            "name": "show_icon",
            "type": "true_false",
            "instructions": "Display icon above text",
            "required": 0,
            "default_value": 1,
            "ui": 1
        },
        {
            "key": "field_content_highlighted_icon",
            "label": "Icon",
            "name": "icon",
            "type": "select",
            "instructions": "Choose an icon",
            "required": 0,
            "choices": {
                "x": "X",
                "asterisk": "Asterisk",
                "star": "Star",
                "circle": "Circle"
            },
            "default_value": "star",
            "allow_null": 0,
            "conditional_logic": [
                [
                    {
                        "field": "field_content_highlighted_show_icon",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_content_highlighted_text",
            "label": "Text Content",
            "name": "text_content",
            "type": "textarea",
            "instructions": "Enter text. Use [brackets] around words to highlight them. Example: This is [highlighted] text.",
            "required": 1,
            "rows": 8,
            "placeholder": "Enter text with [highlighted] words..."
        },
        {
            "key": "field_content_highlighted_background_color",
            "label": "Background Color",
            "name": "background_color",
            "type": "color_picker",
            "instructions": "Choose background color",
            "required": 0,
            "default_value": "#000000"
        },
        {
            "key": "field_content_highlighted_text_color",
            "label": "Text Color",
            "name": "text_color",
            "type": "color_picker",
            "instructions": "Choose main text color",
            "required": 0,
            "default_value": "#757472"
        },
        {
            "key": "field_content_highlighted_highlight_color",
            "label": "Highlight Text Color",
            "name": "highlight_color",
            "type": "color_picker",
            "instructions": "Choose color for highlighted text (words in [brackets])",
            "required": 0,
            "default_value": "#FFFFFF"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/content-highlighted"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

