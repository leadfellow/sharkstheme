{
    "key": "group_cta_block",
    "title": "CTA Block",
    "fields": [
        {
            "key": "field_cta_block_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"cta\", \"contact\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #cta",
            "required": 0,
            "placeholder": "nt. cta, contact, action",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_cta_block_show_on_mobile",
            "label": "Kuva mobiilis",
            "name": "show_on_mobile",
            "type": "true_false",
            "instructions": "Määra, kas see blokk kuvatakse mobiilseadmetes (alla 768px)",
            "required": 0,
            "default_value": 1,
            "ui": 1,
            "ui_on_text": "Jah",
            "ui_off_text": "Ei",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_cta_subheadline",
            "label": "Subheadline (Small text above)",
            "name": "subheadline",
            "type": "text",
            "instructions": "Small text above main title (e.g., 'POLE KINDEL MILLIST VALIDA?')",
            "required": 0,
            "default_value": "",
            "placeholder": "POLE KINDEL MILLIST VALIDA?"
        },
        {
            "key": "field_cta_use_heading_parts",
            "label": "Use Heading Parts (Advanced)",
            "name": "use_heading_parts",
            "type": "true_false",
            "instructions": "Enable to create heading with different text colors",
            "required": 0,
            "default_value": 0
        },
        {
            "key": "field_cta_heading_parts",
            "label": "Heading Parts",
            "name": "heading_parts",
            "type": "repeater",
            "instructions": "Add heading parts with different colors",
            "required": 0,
            "min": 1,
            "max": 0,
            "layout": "block",
            "button_label": "Add Part",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_use_heading_parts",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ],
            "sub_fields": [
                {
                    "key": "field_cta_heading_part_type",
                    "label": "Part Type",
                    "name": "part_type",
                    "type": "select",
                    "instructions": "Choose text or line break",
                    "required": 1,
                    "choices": {
                        "text": "Text",
                        "line_break": "Line Break"
                    },
                    "default_value": "text",
                    "allow_null": 0
                },
                {
                    "key": "field_cta_heading_part_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Text content",
                    "required": 0,
                    "placeholder": "Enter text...",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_cta_heading_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_cta_heading_part_color",
                    "label": "Text Color",
                    "name": "color",
                    "type": "select",
                    "instructions": "Choose text color",
                    "required": 0,
                    "choices": {
                        "white": "White",
                        "gray": "Gray (50% opacity)"
                    },
                    "default_value": "white",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_cta_heading_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                }
            ]
        },
        {
            "key": "field_cta_title",
            "label": "Title (Simple)",
            "name": "title",
            "type": "text",
            "instructions": "CTA title (used when 'Use Heading Parts' is disabled)",
            "required": 0,
            "default_value": "Ready to Get Started?",
            "placeholder": "CTA title...",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_use_heading_parts",
                        "operator": "!=",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_text",
            "label": "Text",
            "name": "text",
            "type": "textarea",
            "instructions": "Supporting text",
            "required": 0,
            "rows": 3,
            "placeholder": "Supporting text..."
        },
        {
            "key": "field_cta_primary_button_text",
            "label": "Primary Button Text",
            "name": "primary_button_text",
            "type": "text",
            "instructions": "Primary button text",
            "required": 0,
            "placeholder": "Get Started"
        },
        {
            "key": "field_cta_primary_button_type",
            "label": "Primary Button Type",
            "name": "primary_button_type",
            "type": "select",
            "instructions": "Choose button action type",
            "required": 0,
            "choices": {
                "link": "Link (Navigate to URL)",
                "modal": "Modal (Open popup)",
                "calendly": "Calendly (Open in new window)"
            },
            "default_value": "link",
            "allow_null": 0
        },
        {
            "key": "field_cta_primary_button_url",
            "label": "Primary Button URL",
            "name": "primary_button_url",
            "type": "url",
            "instructions": "Primary button URL (or Calendly link)",
            "required": 0,
            "placeholder": "https://",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_primary_button_type",
                        "operator": "==",
                        "value": "link"
                    }
                ],
                [
                    {
                        "field": "field_cta_primary_button_type",
                        "operator": "==",
                        "value": "calendly"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_primary_modal_title",
            "label": "Modal Title",
            "name": "primary_modal_title",
            "type": "text",
            "instructions": "Title shown in the modal popup",
            "required": 0,
            "placeholder": "Contact Us",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_primary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_primary_modal_description",
            "label": "Modal Description",
            "name": "primary_modal_description",
            "type": "textarea",
            "instructions": "Optional description shown below modal title",
            "required": 0,
            "rows": 2,
            "placeholder": "Fill out the form below...",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_primary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_primary_modal_content",
            "label": "Modal Content",
            "name": "primary_modal_content",
            "type": "textarea",
            "instructions": "Content shown in the modal. You can use:\n- Contact Form 7 shortcode: [contact-form-7 id=\"123\"]\n- HTML content\n- Text",
            "required": 0,
            "rows": 4,
            "placeholder": "[contact-form-7 id=\"123\" title=\"Contact form\"]",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_primary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_secondary_button_text",
            "label": "Secondary Button Text",
            "name": "secondary_button_text",
            "type": "text",
            "instructions": "Secondary button text",
            "required": 0,
            "placeholder": "Learn More"
        },
        {
            "key": "field_cta_secondary_button_type",
            "label": "Secondary Button Type",
            "name": "secondary_button_type",
            "type": "select",
            "instructions": "Choose button action type",
            "required": 0,
            "choices": {
                "link": "Link (Navigate to URL)",
                "modal": "Modal (Open popup)",
                "calendly": "Calendly (Open in new window)"
            },
            "default_value": "link",
            "allow_null": 0
        },
        {
            "key": "field_cta_secondary_button_url",
            "label": "Secondary Button URL",
            "name": "secondary_button_url",
            "type": "url",
            "instructions": "Secondary button URL (or Calendly link)",
            "required": 0,
            "placeholder": "https://",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_secondary_button_type",
                        "operator": "==",
                        "value": "link"
                    }
                ],
                [
                    {
                        "field": "field_cta_secondary_button_type",
                        "operator": "==",
                        "value": "calendly"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_secondary_modal_title",
            "label": "Modal Title",
            "name": "secondary_modal_title",
            "type": "text",
            "instructions": "Title shown in the modal popup",
            "required": 0,
            "placeholder": "Learn More",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_secondary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_secondary_modal_description",
            "label": "Modal Description",
            "name": "secondary_modal_description",
            "type": "textarea",
            "instructions": "Optional description shown below modal title",
            "required": 0,
            "rows": 2,
            "placeholder": "More information...",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_secondary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_secondary_modal_content",
            "label": "Modal Content",
            "name": "secondary_modal_content",
            "type": "textarea",
            "instructions": "Content shown in the modal. You can use:\n- Contact Form 7 shortcode: [contact-form-7 id=\"123\"]\n- HTML content\n- Text",
            "required": 0,
            "rows": 4,
            "placeholder": "[contact-form-7 id=\"123\" title=\"Contact form\"]",
            "conditional_logic": [
                [
                    {
                        "field": "field_cta_secondary_button_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_cta_show_icon",
            "label": "Show Star Icon",
            "name": "show_icon",
            "type": "true_false",
            "instructions": "Show decorative star icon above heading",
            "required": 0,
            "default_value": 0
        },
        {
            "key": "field_cta_style_variant",
            "label": "Style Variant",
            "name": "style_variant",
            "type": "select",
            "instructions": "Choose a style variation",
            "required": 0,
            "choices": {
                "default": "Default (Primary)",
                "accent": "Accent (Orange)",
                "gradient": "Gradient",
                "dark": "Dark (Black with corners)",
                "dark-pattern": "Dark with Pattern (Star grid background)",
                "light": "Light",
                "centered-dark": "Centered Dark (Marketing Sharks)"
            },
            "default_value": "default",
            "allow_null": 0,
            "multiple": 0
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/cta"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

