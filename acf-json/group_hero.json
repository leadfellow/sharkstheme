{
    "key": "group_hero_block",
    "title": "Hero Block",
    "fields": [
        {
            "key": "field_hero_block_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"hero\", \"contact\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #hero",
            "required": 0,
            "placeholder": "nt. hero, contact, services",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_hero_block_show_on_mobile",
            "label": "Kuva mobiilis",
            "name": "show_on_mobile",
            "type": "true_false",
            "instructions": "Määra, kas see blokk kuvatakse mobiilseadmetes (alla 768px)",
            "required": 0,
            "default_value": 1,
            "ui": 1,
            "ui_on_text": "Jah",
            "ui_off_text": "Ei",
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_hero_headline",
            "label": "Main Title (Center)",
            "name": "headline",
            "type": "text",
            "instructions": "Large main title displayed in the center (e.g., \"KODULEHT\")",
            "required": 1,
            "default_value": "KODULEHT",
            "placeholder": "KODULEHT"
        },
        {
            "key": "field_hero_label",
            "label": "Label (Small text top-left)",
            "name": "label",
            "type": "text",
            "instructions": "Small label text top-left (e.g., \"VEEBIARENDUS\")",
            "required": 0,
            "default_value": "VEEBIARENDUS",
            "placeholder": "VEEBIARENDUS"
        },
        {
            "key": "field_hero_subtitle",
            "label": "Subtitle (White variant only)",
            "name": "subtitle",
            "type": "text",
            "instructions": "Medium-sized subtitle shown between title and description in white variant (optional)",
            "required": 0,
            "default_value": "",
            "placeholder": "Parem nähtavus tagab tiheda liikluse ja kiirendab kasvu"
        },
        {
            "key": "field_hero_tagline",
            "label": "Tagline / Description",
            "name": "tagline",
            "type": "textarea",
            "instructions": "Tagline/description text (Dark/Beige: bottom-left, White: centered below subtitle)",
            "required": 0,
            "default_value": "",
            "placeholder": "SEO ehk search engine optimisation on digikanalite optimeerimine...",
            "rows": 3
        },
        {
            "key": "field_hero_cta_text",
            "label": "CTA Button Text",
            "name": "cta_text",
            "type": "text",
            "instructions": "Call to action button text (optional)",
            "required": 0,
            "placeholder": "Loe edasi"
        },
        {
            "key": "field_hero_cta_type",
            "label": "CTA Button Type",
            "name": "cta_type",
            "type": "select",
            "instructions": "Choose button action type",
            "required": 0,
            "choices": {
                "link": "Link (Navigate to URL)",
                "modal": "Modal (Open popup)",
                "calendly": "Calendly (Open in new window)"
            },
            "default_value": "link",
            "allow_null": 0
        },
        {
            "key": "field_hero_cta_url",
            "label": "CTA Button URL",
            "name": "cta_url",
            "type": "url",
            "instructions": "Call to action button URL (or Calendly link)",
            "required": 0,
            "placeholder": "#contact",
            "conditional_logic": [
                [
                    {
                        "field": "field_hero_cta_type",
                        "operator": "==",
                        "value": "link"
                    }
                ],
                [
                    {
                        "field": "field_hero_cta_type",
                        "operator": "==",
                        "value": "calendly"
                    }
                ]
            ]
        },
        {
            "key": "field_hero_modal_title",
            "label": "Modal Title",
            "name": "modal_title",
            "type": "text",
            "instructions": "Title shown in the modal popup",
            "required": 0,
            "placeholder": "Contact Us",
            "conditional_logic": [
                [
                    {
                        "field": "field_hero_cta_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_hero_modal_description",
            "label": "Modal Description",
            "name": "modal_description",
            "type": "textarea",
            "instructions": "Optional description shown below modal title",
            "required": 0,
            "rows": 2,
            "placeholder": "Fill out the form below...",
            "conditional_logic": [
                [
                    {
                        "field": "field_hero_cta_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_hero_modal_content",
            "label": "Modal Content",
            "name": "modal_content",
            "type": "textarea",
            "instructions": "Content shown in the modal. You can use:\n- Contact Form 7 shortcode: [contact-form-7 id=\"123\"]\n- HTML content\n- Text",
            "required": 0,
            "rows": 4,
            "placeholder": "[contact-form-7 id=\"123\" title=\"Contact form\"]",
            "conditional_logic": [
                [
                    {
                        "field": "field_hero_cta_type",
                        "operator": "==",
                        "value": "modal"
                    }
                ]
            ]
        },
        {
            "key": "field_hero_labels",
            "label": "Labels (Under Hero)",
            "name": "labels",
            "type": "repeater",
            "instructions": "Add service labels that appear under the hero section",
            "required": 0,
            "layout": "table",
            "button_label": "Add Label",
            "sub_fields": [
                {
                    "key": "field_hero_label_text",
                    "label": "Label Text",
                    "name": "label_text",
                    "type": "text",
                    "required": 1,
                    "placeholder": "e.g. UX/UI"
                },
                {
                    "key": "field_hero_label_url",
                    "label": "Link URL (Optional)",
                    "name": "label_url",
                    "type": "url",
                    "instructions": "Optional link for this label",
                    "required": 0,
                    "placeholder": "https://"
                }
            ]
        },
        {
            "key": "field_hero_labels_separator_icon",
            "label": "Separator Icon",
            "name": "labels_separator_icon",
            "type": "select",
            "instructions": "Choose icon to use as separator between labels",
            "required": 0,
            "choices": {
                "x": "X Icon",
                "asterisk": "Asterisk",
                "star": "Star",
                "plus": "Plus",
                "dot": "Dot"
            },
            "default_value": "asterisk",
            "allow_null": 0
        },
        {
            "key": "field_hero_labels_bg_color",
            "label": "Labels Background Color",
            "name": "labels_bg_color",
            "type": "color_picker",
            "instructions": "Choose background color for labels section",
            "required": 0,
            "default_value": "#FF69B4"
        },
        {
            "key": "field_hero_labels_text_color",
            "label": "Labels Text Color",
            "name": "labels_text_color",
            "type": "color_picker",
            "instructions": "Choose text color for labels",
            "required": 0,
            "default_value": "#FFFFFF"
        },
        {
            "key": "field_hero_background_style",
            "label": "Background Style",
            "name": "background_style",
            "type": "select",
            "instructions": "Choose background style",
            "required": 0,
            "choices": {
                "dark": "Dark (Default)",
                "beige": "Beige/Clay",
                "white": "White"
            },
            "default_value": "dark",
            "allow_null": 0
        },
        {
            "key": "field_hero_background_image",
            "label": "Background Image",
            "name": "background_image",
            "type": "image",
            "instructions": "Optional background image (will overlay on background style)",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/hero"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}
