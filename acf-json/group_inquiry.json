{
    "key": "group_inquiry_block",
    "title": "Inquiry Block",
    "fields": [
        {
            "key": "field_inquiry_title",
            "label": "Header Title (Scrolling)",
            "name": "title",
            "type": "text",
            "instructions": "Title for scrolling header (e.g., 'KIRJUTAMEILE')",
            "required": 1,
            "default_value": "KIRJUTAMEILE",
            "placeholder": "KIRJUTAMEILE"
        },
        {
            "key": "field_inquiry_submit_text",
            "label": "Submit Section Title",
            "name": "submit_text",
            "type": "text",
            "instructions": "Title shown in black submit section (e.g., 'SAADA PÄRING')",
            "required": 1,
            "default_value": "SAADA PÄRING",
            "placeholder": "SAADA PÄRING"
        },
        {
            "key": "field_inquiry_icons",
            "label": "Icons",
            "name": "icons",
            "type": "repeater",
            "instructions": "Add decorative icons (max 5)",
            "required": 0,
            "min": 0,
            "max": 5,
            "layout": "table",
            "button_label": "Add Icon",
            "sub_fields": [
                {
                    "key": "field_inquiry_icon_type",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "instructions": "Choose an icon",
                    "required": 1,
                    "choices": {
                        "asterisk": "Asterisk (✱)",
                        "star": "Star (✦)",
                        "x": "X (✕)",
                        "circle": "Circle (●)",
                        "sunburst": "Sunburst (※)"
                    },
                    "default_value": "asterisk",
                    "allow_null": 0
                }
            ]
        },
        {
            "key": "field_inquiry_cf7_shortcode",
            "label": "Contact Form 7 Shortcode",
            "name": "cf7_shortcode",
            "type": "text",
            "instructions": "Paste Contact Form 7 shortcode (e.g., [contact-form-7 id=\"123\"])",
            "required": 1,
            "placeholder": "[contact-form-7 id=\"123\" title=\"Contact form\"]"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/inquiry"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

