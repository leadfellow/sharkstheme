            "default_value": "asterisk",
            "allow_null": 0,
            "multiple": 0,
            "ui": 1,
            "ajax": 0,
            "return_format": "value",
            "wrapper": {
                "width": "33"
            }
        },
        {
            "key": "field_progress_right_icon",
            "label": "Right Icon",
            "name": "right_icon",
