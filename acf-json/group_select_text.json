{
    "key": "group_select_text_block",
    "title": "Select Text Block (Tabs)",
    "fields": [
        {
            "key": "field_select_text_tabs",
            "label": "Tabs",
            "name": "tabs",
            "type": "repeater",
            "instructions": "Add tabs with titles and content",
            "required": 1,
            "min": 2,
            "max": 10,
            "layout": "block",
            "button_label": "Add Tab",
            "sub_fields": [
                {
                    "key": "field_select_text_tab_title",
                    "label": "Tab Title",
                    "name": "title",
                    "type": "text",
                    "instructions": "The tab name that users will click",
                    "required": 1,
                    "placeholder": "Enter tab title...",
                    "wrapper": {
                        "width": "100"
                    }
                },
                {
                    "key": "field_select_text_tab_content",
                    "label": "Tab Content",
                    "name": "content",
                    "type": "wysiwyg",
                    "instructions": "The content to display when this tab is active",
                    "required": 0,
                    "tabs": "all",
                    "toolbar": "basic",
                    "media_upload": 0,
                    "wrapper": {
                        "width": "100"
                    }
                }
            ]
        },
        {
            "key": "field_select_text_show_icon",
            "label": "Show Top Icon",
            "name": "show_icon",
            "type": "true_false",
            "instructions": "Display starburst icon at the top",
            "required": 0,
            "message": "Show icon",
            "default_value": 1,
            "ui": 1,
            "ui_on_text": "Yes",
            "ui_off_text": "No"
        },
        {
            "key": "field_select_text_background",
            "label": "Background Color",
            "name": "background_color",
            "type": "color_picker",
            "instructions": "Choose background color",
            "required": 0,
            "default_value": "#ffffff",
            "enable_opacity": 1,
            "return_format": "string"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/select-text"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

