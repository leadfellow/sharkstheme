{
    "key": "group_specialist_block",
    "title": "Specialist Block",
    "fields": [
        {
            "key": "field_specialist_heading_parts",
            "label": "Heading Parts",
            "name": "heading_parts",
            "type": "repeater",
            "instructions": "Add heading parts with text, icons, line breaks, and colors",
            "required": 0,
            "min": 1,
            "max": 0,
            "layout": "block",
            "button_label": "Add Part",
            "sub_fields": [
                {
                    "key": "field_specialist_part_type",
                    "label": "Part Type",
                    "name": "part_type",
                    "type": "select",
                    "instructions": "Choose text, icon, or line break",
                    "required": 1,
                    "choices": {
                        "text": "Text",
                        "icon": "Icon",
                        "line_break": "Line Break"
                    },
                    "default_value": "text",
                    "allow_null": 0
                },
                {
                    "key": "field_specialist_part_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Text content",
                    "required": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_specialist_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ],
                    "placeholder": "MARKETING SHARKSI"
                },
                {
                    "key": "field_specialist_part_color",
                    "label": "Text Color",
                    "name": "color",
                    "type": "select",
                    "instructions": "Choose text color",
                    "required": 0,
                    "choices": {
                        "black": "Black",
                        "gray": "Gray"
                    },
                    "default_value": "black",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_specialist_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_specialist_part_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "instructions": "Choose an icon",
                    "required": 0,
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "asterisk",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_specialist_part_type",
                                "operator": "==",
                                "value": "icon"
                            }
                        ]
                    ]
                }
            ]
        },
        {
            "key": "field_specialist_bio_text",
            "label": "Bio Text",
            "name": "bio_text",
            "type": "textarea",
            "instructions": "Specialist biography text (supports paragraphs)",
            "required": 0,
            "rows": 8,
            "placeholder": "Turundushai Tanel on SEOga toimetanud..."
        },
        {
            "key": "field_specialist_image",
            "label": "Profile Image",
            "name": "image",
            "type": "image",
            "instructions": "Upload specialist profile image (recommended: 428x666px or 2:3 ratio)",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_specialist_name",
            "label": "Name",
            "name": "name",
            "type": "text",
            "instructions": "Specialist full name",
            "required": 0,
            "placeholder": "Tanel Lorem ipsum"
        },
        {
            "key": "field_specialist_position",
            "label": "Position/Title",
            "name": "position",
            "type": "text",
            "instructions": "Job title or position",
            "required": 0,
            "placeholder": "SEO-spetsialist"
        },
        {
            "key": "field_specialist_linkedin_url",
            "label": "LinkedIn URL",
            "name": "linkedin_url",
            "type": "url",
            "instructions": "LinkedIn profile URL",
            "required": 0,
            "placeholder": "https://linkedin.com/in/username"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/specialist"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

