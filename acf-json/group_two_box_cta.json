{
    "key": "group_two_box_cta_block",
    "title": "Two Box CTA Block",
    "fields": [
        {
            "key": "field_two_box_cta_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"cta\", \"boxes\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #cta",
            "required": 0,
            "placeholder": "nt. cta, boxes",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_two_box_cta_background_color",
            "label": "Section Background Color",
            "name": "section_background_color",
            "type": "color_picker",
            "instructions": "Choose section background color",
            "required": 0,
            "default_value": "#FFFFFF"
        },
        {
            "key": "field_two_box_cta_card_background_color",
            "label": "Card Background Color",
            "name": "card_background_color",
            "type": "color_picker",
            "instructions": "Choose card background color (applies to both cards)",
            "required": 0,
            "default_value": "#F7F7F5"
        },
        {
            "key": "field_two_box_cta_left_card",
            "label": "Left Card",
            "name": "left_card",
            "type": "group",
            "instructions": "Configure left card",
            "required": 0,
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_two_box_cta_left_show_icon",
                    "label": "Show Icon",
                    "name": "show_icon",
                    "type": "true_false",
                    "instructions": "Display icon",
                    "default_value": 1,
                    "ui": 1
                },
                {
                    "key": "field_two_box_cta_left_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "asterisk",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_left_show_icon",
                                "operator": "==",
                                "value": "1"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_two_box_cta_left_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1,
                    "placeholder": "VALMISPÕHI"
                },
                {
                    "key": "field_two_box_cta_left_content_type",
                    "label": "Content Type",
                    "name": "content_type",
                    "type": "radio",
                    "choices": {
                        "labels": "Feature Labels (+/-)",
                        "text": "Plain Text"
                    },
                    "default_value": "labels",
                    "layout": "horizontal"
                },
                {
                    "key": "field_two_box_cta_left_features",
                    "label": "Feature Labels",
                    "name": "features",
                    "type": "repeater",
                    "min": 0,
                    "max": 10,
                    "layout": "table",
                    "button_label": "Add Feature",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_left_content_type",
                                "operator": "==",
                                "value": "labels"
                            }
                        ]
                    ],
                    "sub_fields": [
                        {
                            "key": "field_two_box_cta_left_feature_type",
                            "label": "Type",
                            "name": "feature_type",
                            "type": "select",
                            "choices": {
                                "plus": "+ (Yellow)",
                                "minus": "- (Pink)"
                            },
                            "default_value": "plus"
                        },
                        {
                            "key": "field_two_box_cta_left_feature_text",
                            "label": "Text",
                            "name": "feature_text",
                            "type": "text",
                            "required": 1
                        }
                    ]
                },
                {
                    "key": "field_two_box_cta_left_description",
                    "label": "Description Text",
                    "name": "description_text",
                    "type": "textarea",
                    "rows": 6,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_left_content_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_two_box_cta_left_button_text",
                    "label": "Button Text",
                    "name": "button_text",
                    "type": "text",
                    "required": 1,
                    "default_value": "Saada päring"
                },
                {
                    "key": "field_two_box_cta_left_button_url",
                    "label": "Button URL",
                    "name": "button_url",
                    "type": "url",
                    "required": 1,
                    "placeholder": "#contact"
                }
            ]
        },
        {
            "key": "field_two_box_cta_right_card",
            "label": "Right Card",
            "name": "right_card",
            "type": "group",
            "instructions": "Configure right card",
            "required": 0,
            "layout": "block",
            "sub_fields": [
                {
                    "key": "field_two_box_cta_right_show_icon",
                    "label": "Show Icon",
                    "name": "show_icon",
                    "type": "true_false",
                    "instructions": "Display icon",
                    "default_value": 1,
                    "ui": 1
                },
                {
                    "key": "field_two_box_cta_right_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "star",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_right_show_icon",
                                "operator": "==",
                                "value": "1"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_two_box_cta_right_title",
                    "label": "Title",
                    "name": "title",
                    "type": "text",
                    "required": 1,
                    "placeholder": "ERIDISAIN"
                },
                {
                    "key": "field_two_box_cta_right_content_type",
                    "label": "Content Type",
                    "name": "content_type",
                    "type": "radio",
                    "choices": {
                        "labels": "Feature Labels (+/-)",
                        "text": "Plain Text"
                    },
                    "default_value": "labels",
                    "layout": "horizontal"
                },
                {
                    "key": "field_two_box_cta_right_features",
                    "label": "Feature Labels",
                    "name": "features",
                    "type": "repeater",
                    "min": 0,
                    "max": 10,
                    "layout": "table",
                    "button_label": "Add Feature",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_right_content_type",
                                "operator": "==",
                                "value": "labels"
                            }
                        ]
                    ],
                    "sub_fields": [
                        {
                            "key": "field_two_box_cta_right_feature_type",
                            "label": "Type",
                            "name": "feature_type",
                            "type": "select",
                            "choices": {
                                "plus": "+ (Yellow)",
                                "minus": "- (Pink)"
                            },
                            "default_value": "plus"
                        },
                        {
                            "key": "field_two_box_cta_right_feature_text",
                            "label": "Text",
                            "name": "feature_text",
                            "type": "text",
                            "required": 1
                        }
                    ]
                },
                {
                    "key": "field_two_box_cta_right_description",
                    "label": "Description Text",
                    "name": "description_text",
                    "type": "textarea",
                    "rows": 6,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_two_box_cta_right_content_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_two_box_cta_right_button_text",
                    "label": "Button Text",
                    "name": "button_text",
                    "type": "text",
                    "required": 1,
                    "default_value": "Saada päring"
                },
                {
                    "key": "field_two_box_cta_right_button_url",
                    "label": "Button URL",
                    "name": "button_url",
                    "type": "url",
                    "required": 1,
                    "placeholder": "#contact"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/two-box-cta"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}

