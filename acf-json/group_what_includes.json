            "button_label": "Add Item",
            "sub_fields": [
                {
                    "key": "field_what_includes_item_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Item description",
                    "required": 1,
                    "placeholder": "Erinevaid maksemeetodeid"
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/what-includes"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
