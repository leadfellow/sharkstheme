{
    "key": "group_works1_block",
    "title": "Works1 Block",
    "fields": [
        {
            "key": "field_works1_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"work\", \"projekt\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #work",
            "required": 0,
            "placeholder": "nt. work, projekt",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_works1_background_color",
            "label": "Background Color",
            "name": "background_color",
            "type": "color_picker",
            "instructions": "Choose background color for the entire section",
            "required": 0,
            "default_value": "#ffffff"
        },
        {
            "key": "field_works1_text_color",
            "label": "Text Color",
            "name": "text_color",
            "type": "color_picker",
            "instructions": "Choose text color for the section",
            "required": 0,
            "default_value": "#000000"
        },
        {
            "key": "field_works1_heading_parts",
            "label": "Heading Parts",
            "name": "heading_parts",
            "type": "repeater",
            "instructions": "Add heading parts with different colors, icons, and line breaks",
            "required": 0,
            "min": 1,
            "max": 0,
            "layout": "block",
            "button_label": "Add Part",
            "sub_fields": [
                {
                    "key": "field_works1_part_type",
                    "label": "Part Type",
                    "name": "part_type",
                    "type": "select",
                    "instructions": "Choose text, icon, or line break",
                    "required": 1,
                    "choices": {
                        "text": "Text",
                        "icon": "Icon",
                        "line_break": "Line Break"
                    },
                    "default_value": "text",
                    "allow_null": 0
                },
                {
                    "key": "field_works1_part_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Text content",
                    "required": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works1_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ],
                    "placeholder": "Enter text..."
                },
                {
                    "key": "field_works1_part_color",
                    "label": "Text Color",
                    "name": "color",
                    "type": "select",
                    "instructions": "Choose text color",
                    "required": 0,
                    "choices": {
                        "black": "Black",
                        "gray": "Gray"
                    },
                    "default_value": "black",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works1_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_works1_part_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "instructions": "Choose an icon",
                    "required": 0,
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "star",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works1_part_type",
                                "operator": "==",
                                "value": "icon"
                            }
                        ]
                    ]
                }
            ]
        },
        {
            "key": "field_works1_subtitle",
            "label": "Subtitle (Under Heading)",
            "name": "subtitle",
            "type": "textarea",
            "instructions": "Subtitle text shown under heading",
            "required": 0,
            "rows": 2,
            "placeholder": "Tarbija teekond ja veebilehe väljanägemine"
        },
        {
            "key": "field_works1_description",
            "label": "Description Text (Right Column)",
            "name": "description",
            "type": "textarea",
            "instructions": "Description text on the right side",
            "required": 0,
            "rows": 6,
            "placeholder": "Enter description text..."
        },
        {
            "key": "field_works1_image",
            "label": "Large Image",
            "name": "image",
            "type": "image",
            "instructions": "Large image (1324x765px recommended)",
            "required": 0,
            "return_format": "array",
            "preview_size": "medium",
            "library": "all"
        },
        {
            "key": "field_works1_image_bg_color",
            "label": "Image Background Color",
            "name": "image_bg_color",
            "type": "color_picker",
            "instructions": "Background color for image container (default: black)",
            "required": 0,
            "default_value": "#000000"
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/works1"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true
}



