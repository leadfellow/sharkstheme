            "name": "heading_parts",
            "type": "repeater",
            "instructions": "Add heading parts with different colors, icons, and line breaks",
            "required": 0,
            "min": 1,
            "max": 0,
            "layout": "block",
            "button_label": "Add Part",
            "sub_fields": [
                {
                    "key": "field_works3_part_type",
                    "label": "Part Type",
                    "name": "part_type",
                    "type": "select",
                    "instructions": "Choose text, icon, or line break",
                    "required": 1,
                    "choices": {
                        "text": "Text",
                        "icon": "Icon",
                        "line_break": "Line Break"
                    },
                    "default_value": "text",
                    "allow_null": 0
                },
                {
                    "key": "field_works3_part_text",
                    "label": "Text",
                    "name": "text",
                    "type": "text",
                    "instructions": "Text content",
                    "required": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works3_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ],
                    "placeholder": "Enter text..."
                },
                {
                    "key": "field_works3_part_color",
                    "label": "Text Color",
                    "name": "color",
                    "type": "select",
                    "instructions": "Choose text color",
                    "required": 0,
                    "choices": {
                        "white": "White",
                        "gray": "Gray"
                    },
                    "default_value": "white",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works3_part_type",
                                "operator": "==",
                                "value": "text"
                            }
                        ]
                    ]
                },
                {
                    "key": "field_works3_part_icon",
                    "label": "Icon",
                    "name": "icon",
                    "type": "select",
                    "instructions": "Choose an icon",
                    "required": 0,
                    "choices": {
                        "x": "X",
                        "asterisk": "Asterisk",
                        "star": "Star",
                        "circle": "Circle"
                    },
                    "default_value": "x",
                    "allow_null": 0,
                    "conditional_logic": [
                        [
                            {
                                "field": "field_works3_part_type",
                                "operator": "==",
                                "value": "icon"
                            }
                        ]
                    ]
                }
            ]
        },
