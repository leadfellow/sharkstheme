{
    "key": "group_works3_block",
    "title": "Works3 Block",
    "fields": [
        {
            "key": "field_works3_anchor",
            "label": "Anchor (ID)",
            "name": "block_anchor",
            "type": "text",
            "instructions": "Sisesta ankru nimi sisemiste linkide jaoks (nt. \"works\", \"projektid\"). Kasuta ainult väiketähti, numbreid ja kriipse. Seejärel saad linkida: #works",
            "required": 0,
            "placeholder": "nt. works, projektid",
            "prepend": "#",
            "maxlength": 50,
            "wrapper": {
                "width": "50"
            }
        },
        {
            "key": "field_works3_background_color",
            "label": "Background Color",
            "name": "background_color",
            "type": "color_picker",
            "instructions": "Choose background color for the entire section",
            "required": 0,
            "default_value": "#000000"
        },
        {
            "key": "field_works3_text_color",
            "label": "Text Color",
            "name": "text_color",
            "type": "color_picker",
            "instructions": "Choose text color for the section",
            "required": 0,
            "default_value": "#ffffff"
        },
        {
            "key": "field_works3_heading_parts",
